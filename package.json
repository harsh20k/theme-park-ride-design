{
  "name": "papercraft-park-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Papercraft Park Library — a handmade 3D theme park that is also a library of theme-park & ride design knowledge.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "content:check": "tsx scripts/content-check.ts",
    "content:check:sample": "CONTENT_SOURCE=sample tsx scripts/content-check.ts",
    "content:check:real": "CONTENT_SOURCE=real tsx scripts/content-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.1.0",
    "d3-force": "^3.0.0",
    "fuse.js": "^7.1.0",
    "katex": "^0.16.22",
    "maath": "^0.10.8",
    "mermaid": "^11.12.0",
    "postprocessing": "^6.37.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.180.0",
    "vega": "^6.1.2",
    "vega-embed": "^7.0.2",
    "vega-lite": "^6.2.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gray-matter": "^4.0.3",
    "playwright-core": "^1.64.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
